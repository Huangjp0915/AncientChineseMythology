		Tooltip:
			'''
			由亵渎血肉凝聚而成的恐怖巨剑
			三段连击：横斩→上挑→下劈，挥出蠕动血肉波
			刀身命中叠加剖检印，下劈双倍并震撼大地
			叠满五层剖检印触发摘取：凝视巨眼爆裂处决并治疗自身
			'''
	}

	GluttonousFleshrang: {
		DisplayName: 贪噬肉旋
		Tooltip:
			'''
			被活物血肉包裹的回旋利器
			返回时伤害提升80%，命中吸取生命并叠加剖检印
			单程命中三次后接住可进入"饱食"：镖体膨胀、更痛更贪
			每累积4次命中释放追踪血肉触手
			'''
	}

	TwitchingTendonBow: {
		DisplayName: 搐筋弓
		Tooltip:
			'''
			以跳动筋腱为弦的诡异长弓，按住拉弦蓄力
			满弦"痉挛"射出高穿透脊椎箭与双螺旋飞刃
			痉挛箭命中肋骨爆裂并叠加剖检印
			每第三次满弦凝聚追踪畸变眼球
			'''
	}

	VisceraSpitter: {
		DisplayName: 脏器喷吐枪
		Tooltip:
			'''
			蠕动的血肉枪管喷射高速血弹
			五连发高速穿透血液弹丸
			每25发蓄压喷出巨型脏器弹——最后五发心跳加速预告
			脏器弹直击叠加剖检印，爆裂为追踪血肉触手
			'''
	}

	BurstingTumorBomb: {
		DisplayName: 爆裂肉瘤
		Tooltip:
			'''
			充满压力的肿胀肉瘤，按住攻击令其"孕育"膨胀
			孕育越久：伤害、碎片与爆炸范围越大
			弧线飞行并可弹跳一次，直击叠加剖检印
			爆炸释放追踪血肉碎片
			'''
	}

	GazingFleshGrimoire: {
		DisplayName: 凝视肉典
		Tooltip:
			'''
			以血肉封印的禁忌魔法书
			扇形散射7道血液弹幕
			每四次施法睁开凝视巨眼：追踪、锁定、爆裂为触手
			巨眼直击叠加双层剖检印
			'''
	}

	AberrantEyeStaff: {
		DisplayName: 畸变眼球杖
		Tooltip:
			'''
			由无数畸变眼球凝聚的诡异法杖
			持续引导令其苏醒：触手更多、更快、更密集
			每6次释放追踪畸变眼球，直击叠加双层剖检印
			眼球爆裂释放环形血液弹幕
			'''
	}

