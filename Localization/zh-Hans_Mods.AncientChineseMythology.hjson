	HellwyrmAnnihilationCannon: {
		DisplayName: 地狱冥龙吐纳寂灭炮
		Tooltip:
			'''
			封印地狱冥龙吐息之力的终极火炮，无需凡俗弹药
			按住"纳"聚冥魂三档蓄力，松开"吐"出膨胀的冥焰龙息
			蓄力越深龙息越巨，满纳波头凝出冥龙魂首
			命中施加寂灭龙印，2秒后引爆（满纳龙息印记×2.5）
			龙吟震天，寂灭万物
			'''
	}

	AbyssalFrostJudgmentChakram: {
		DisplayName: 极寒渊薮九幽判官轮
