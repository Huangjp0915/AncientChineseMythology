	YuChangSword: {
		DisplayName: 鱼肠剑
		Tooltip:
			'''
			三寸寒锋，薄如蝉翼
			出鞘无声，生死已判
			每第四刺为透骨刺: 伤害提高并放出鱼影飞刃, 顺势向光标滑步
			右键穿心·背刺 (8 秒冷却): 瞬身至目标背侧三段连刺
			残血普通敌人将被背刺处决; 无目标时化为幽影突进
			'''
	}

	ShenxianGuanglunItem: {
		DisplayName: 神仙光轮
		Tooltip: ""
	}

	CloudMountItem: {
		DisplayName: 祥云
		Tooltip: ""
	}

	GanJiangSword: {
		DisplayName: 干将剑
		Tooltip:
			'''
			干将莫邪, 雌雄双剑
			左键三连段: 正斩→逆斩→双剑十字旋斩, 每段有莫邪虚剑影随补斩
			双剑任意命中积攒剑鸣 (上限 10)
			右键: 满鸣时施展合鸣·雌雄合璧 —— 赤金×青蓝交叉巨剑气, 展开阴阳双鱼盘
			未满鸣时遣出莫邪虚剑寻敌斩
			“雌雄相合, 剑气冲天”
			'''
	}

	AureateVoidrender: {
		DisplayName: 辉金虚空斩裂刃
		Tooltip:
			'''
			神威断罪所铸的高速金装虚空刃
			每次挥砍释放三道穿透型金紫虚空斩浪，适合高速清图
			每第三斩爆发五道扇形斩浪，并在光标处撕开吞噬虚空裂隙
			'''
	}

	CelestialHubAnnihilator: {
		DisplayName: 天枢聚能湮灭炮
		Tooltip:
			'''
			聚合天枢星力，发射三叉湮灭炮弹
			炮弹落点爆发出毁天灭地的星力湮灭
			'''
	}

	CelestialCircletScepter: {
		DisplayName: 天冠权杖
		Tooltip:
			'''
			释放五枚耀能环螺旋收束后追踪冲刺
			耀能环消逝时加冕爆发，绽放天冠光环造成范围重创
			1300 魔法伤害
			'''
	}

	GeoarchonRupturer: {
		DisplayName: 坤铉破渊权杖
		Tooltip:
			'''
			在光标处刻印地脉裂穴阵，预兆后自地面刺出七柱地能岩柱
			岩柱崩碎时迸射上冲地晶残刺；右键倾注法力展开十二柱镇渊大裂阵
			1500 魔法伤害
			'''
	}

	AurelianCataclysmSmasher: {
		DisplayName: 万劫狂金震碎者
		Tooltip:
			'''
			白虎金纹灾锤 · 1580 近战伤害
			掷出回旋金锤，触地或命中时沿地面裂放金纹冲击波，震波撕裂护甲
			灾锤回手时砸地引爆双向裂地震潮
			'''
	}

	AzureRuinBlade: {
		DisplayName: 苍海毁刃
		Tooltip: 持握挥砍，斩击中段释放蔚蓝潮汐雷浪 · 雷浪可连锁附近敌人
	}

	GeocrystalShatterblade: {
		DisplayName: 地晶裂碎大剑
		Tooltip:
			'''
			挥砍命中时迸射熔岩地晶爆裂，连击共鸣愈盛、迸射愈烈
			满共鸣触发地晶超载；右键劈出扇形熔岩晶刺 · 1450 近战伤害
			'''
	}

	QuadraseaCataclysmicEdge: {
		DisplayName: 四海灾变锋刃
		Tooltip:
			'''
			汇聚四海之威，斩出绿珊瑚三重剑波
			挥击时发射三道珊瑚海洋剑气
			'''
	}

	VortexPrimordialStain: {
		DisplayName: 漩流玄印魔书
		Tooltip: 释放三枚水墨漩涡 orb，蛇形追踪敌人 · 365 魔法伤害
	}

	LuminanceStellarCannon: {
		DisplayName: 光华星炮
		Tooltip:
			'''
			百目天目所铸的聚星重炮
			蓄聚紫蓝星光射出光华能束，命中后引发恒星爆发
			爆发抛射四枚追踪星屑，回旋追猎残敌
			'''
	}

	LuminousIrisAnnihilator: {
		DisplayName: 虹膜湮灭手铳
		Tooltip:
			'''
			百目虹膜手铳，将子弹化为耀金虹膜光弹
			长按蓄力环聚虹膜，松手释放金色光弹连射爆发
			满蓄释放召出全视之眼，自动洞察敌人并连射虹膜光弹
			'''
	}

	TwilightGlazeGreatbow: {
		DisplayName: 暮光流华大弓
		Tooltip:
			'''
			暮色流华之弓，无论何种箭矢皆化为珊瑚海洋之箭
			发射穿透青珊瑚箭，命中后绽放海洋光爆
			'''
	}

	StarfireAnnihilator: {
		DisplayName: 星火灭杀枪
		Tooltip:
			'''
			发射穿透珊瑚星火弹，贯穿后绽放星火星海爆裂
			右键凝聚珊瑚超新星，缓缓推进吸卷群敌，炸裂为漫天星火 · 1520 远程伤害
			'''
	}

	VaultshadeVoidshot: {
		DisplayName: 库藏虚空狙
		Tooltip:
			'''
			发射随飞行持续生长的虚空弹，越大越痛
			命中后触发虚空坍缩，将附近敌人拉向中心
			坍缩瓦解时迸射招财金镖，洗劫被困之敌
			'''
	}

	ArgentPulseObliterator: {
