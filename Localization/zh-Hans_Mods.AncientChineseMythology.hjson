			诸天万界，一刀断之
			'''
	}

	DamnedSoulguide: {
		DisplayName: 黄泉万劫引魂弓
		Tooltip:
			'''
			引渡遭受万劫不复之苦的灵魂
			每次射出五支追踪万劫箭，概率额外射出三支灵魂箭
			暴击时触发灵魂连锁爆发，牵引附近敌人的灵魂
			黄泉路上，无魂可逃
			'''
	}

	SoulEatingCannon: {
		DisplayName: 冥府噬魂幽火炮
		Tooltip:
			'''
			能吞噬灵魂的重型冥府火器
			散射10到15发噬魂弹，命中后灵魂爆裂
			击杀敌人后吸收灵魂回复生命
			炮火所至，灵魂尽灭
			'''
	}

	InfinityKarmaBlade: {
		DisplayName: 孽镜无间回旋刃
		Tooltip:
			'''
			如同无间地狱般永无止境轮回的利刃
			三刃齐发，镜像反射加深伤害
			暴击时触发无间镜像反伤，敌人的罪孽加倍奉还
			轮回不止，因果不灭
			'''
	}

	OblivionSoulhook: {
		DisplayName: 判官寂灭勾魂枪
		Tooltip:
			'''
			带来终极寂灭和死亡的判官之枪
			极大突刺范围，每次命中大量吸收灵魂回复生命
			击杀敌人时触发寂灭爆发，对范围内所有敌人造成毁灭伤害
			判官落笔，万物寂灭
			'''
	}

	CodexofMyriadDemons: {
		DisplayName: 生死因果万魔录
		Tooltip:
			'''
			记载万魔因果、掌控生死轮回的终极秘典
			每次释放五枚追踪万魔符文
			暴击时触发全范围链式雷击，连锁五个敌人
			万魔臣服，因果轮转
			'''
	}

	StaveofNetherEclipse: {
		DisplayName: 黄泉寂灭冥罗杖
		Tooltip:
			'''
			凝聚黄泉寂灭之力、显化冥府罗网的法杖
			同时发射三枚寂灭冥球，命中后展开冥府罗网
			罗网区域内所有敌人受到减速和暗影焰侵蚀
			罗网天下，无处遁逃
			'''
	}

	SoulShatteringUnderworldBomb: {
		DisplayName: 冥岩碎魂黄泉雷
		Tooltip:
			'''
			能粉碎灵魂、开启黄泉之门的冥岩重雷
			爆炸后分裂为三枚子雷，每枚拥有巨大爆炸范围
			黄泉之门一旦打开，灵魂无处可藏
			碎魂裂魄，天崩地陷
			'''
	}

	CelestialImperatorGreatblade: {
		DisplayName: 酆都万劫寂灭黑帝刀
		Tooltip:
			'''
			阴天子亲铸的万劫寂灭之刃，斩尽六道一切轮回
			三连击循环：前两击释放五道黑帝斩，第三击引爆虚空万劫柱
			暴击时对600范围内所有敌人造成连锁审判
			非Boss敌人血量低于25%时直接寂灭
			万劫不复，诸天归寂
			'''
	}

	PrimordialChaosDeicideBow: {
		DisplayName: 混元吞天万羽坠神弓
		Tooltip:
			'''
