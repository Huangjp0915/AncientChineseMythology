	ArrogantDivineSylvanStaff: {
		DisplayName: 傲世神木·万藤杖
		Tooltip:
			'''
			以万年神木之心雕琢的终极灵杖
			释放巨型藤蔓链鞭抽击敌人
			链身分生追踪触手独立造成伤害
			命中后释放八片追踪叶爆
			末端触发藤蔓新星：十六道环形爆炸
			'''
	}

	ArrogantDivineSylvanTome: {
		DisplayName: 傲世神木·山海典
		Tooltip:
			'''
			记载天地万木灵韵的上古至宝
			释放20~28片金翠叶刃扇形散射
			叶片螺旋飞行后强力追踪敌人
			命中50%概率释放双花瓣次生弹幕
			每三次使用凝聚叶暴漩涡，引力吸拢万物
			'''
	}

	WoodenLeafPendant: {
		DisplayName: 木制叶纹吊坠
		Tooltip: 散发着微弱的自然气息，为佩戴者提供少许生命恢复
	}

	VineWovenShield: {
		DisplayName: 盘藤护盾
		Tooltip:
			'''
			由粗糙的树枝和坚韧的藤蔓编织而成
			增加1点防御力
			受到近战接触伤害时反弹微弱的荆棘伤害
			'''
	}

	ForestCrystalAmulet: {
		DisplayName: 森灵晶核护符
		Tooltip:
			'''
			蕴含森林绿晶魔力的古朴护符
			增加20点最大法力值
			降低3%的魔法消耗
			'''
	}

	BarkReinforcedGlove: {
		DisplayName: 树皮加固手套
		Tooltip:
			'''
			虽然戴着有些磨手，但能很好地保护手腕
			提升5%的近战与工具挥动速度
			'''
	}

	WoodlandBarkBoots: {
		DisplayName: 林地木靴
		Tooltip:
			'''
			用厚实的树皮和苔藓制成，踩在地上异常无声
			增加5%移动速度
			在草地或泥土上时额外降低坠落伤害
			'''
	}

	ProfaneDismemberer: {
		DisplayName: 亵渎肢解刃
		Tooltip:
			'''
			由亵渎血肉凝聚而成的恐怖巨剑
			三段连击：横斩→上挑→下劈
			挥斩沿途释放暗红血肉波
			下劈威力提升30%并震撼地面
			'''
	}

	GluttonousFleshrang: {
		DisplayName: 贪噬肉旋
		Tooltip:
			'''
			被活物血肉包裹的回旋利器
			返回时伤害提升80%
			命中敌人吸取少量生命值
			每累积4次命中释放追踪血肉触手
			'''
	}

	TwitchingTendonBow: {
		DisplayName: 搐筋弓
		Tooltip:
			'''
			由跳动筋腱编织的诡异长弓
			发射穿透脊椎箭矢，附带旋转碎片
			每三发凝聚一颗追踪畸变眼球
			眼球碰撞后爆裂为追踪血肉触手
			'''
	}

	VisceraSpitter: {
		DisplayName: 脏器喷吐枪
		Tooltip:
			'''
			蠕动的血肉枪管喷射高速血弹
			五连发高速穿透血液弹丸
			每25发凝聚一颗巨型脏器弹
			脏器弹爆炸释放追踪血肉触手
			'''
	}

	BurstingTumorBomb: {
		DisplayName: 爆裂肉瘤
		Tooltip:
			'''
			充满压力的肿胀肉瘤投掷物
			弧线飞行并可弹跳一次
			爆炸释放8道追踪血肉碎片
			造成大范围血液爆破伤害
			'''
	}

	GazingFleshGrimoire: {
		DisplayName: 凝视肉典
		Tooltip:
			'''
			以血肉封印的禁忌魔法书
			扇形散射10道血液弹幕
			每四次施法释放追踪巨型凝视眼球
			眼球爆裂释放8道追踪触手
			'''
	}

	AberrantEyeStaff: {
		DisplayName: 畸变眼球杖
		Tooltip:
			'''
			由无数畸变眼球凝聚的诡异法杖
			连续释放追踪血肉触手
			每6次释放追踪畸变眼球弹
			眼球爆裂释放环形血液弹幕
			'''
	}
}

