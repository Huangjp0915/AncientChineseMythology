			'''
	}

	CelestialHubAnnihilator: {
		DisplayName: 天枢聚能湮灭炮
		Tooltip:
			'''
			聚合天枢星力，发射三叉湮灭炮弹
			炮弹落点爆发出毁天灭地的星力湮灭
			'''
	}

	CelestialCircletScepter: {
		DisplayName: 天枢耀能环流杖
		Tooltip:
			'''
			汇聚天枢的能量，释放5枚旋转耀能光环
			光环螺旋收束后追踪最近的目标冲刺贯穿
			'''
	}

	GeoarchonRupturer: {
		DisplayName: 坤铉破渊权杖
		Tooltip:
			'''
			坤力共鸣，大地震裂，渊底崩塌
			在目标位置召唤七根地能裂穴能量柱
			'''
	}

	AurelianCataclysmSmasher: {
		DisplayName: 万劫狂金震碎者
		Tooltip:
			'''
			集万劫之力于一击，砸碎一切的狂金重锤
			命中时掀起全场金色裂地冲击波，令大地颤抖
			'''
	}

	AzureRuinBlade: {
		DisplayName: 蔚蓝毁刃
		Tooltip:
			'''
			凝聚蔚蓝大海之力，斩出奔涌潮砍
			挥击时释放汹涌的蓝色潮汐剑气
			'''
	}

	GeocrystalShatterblade: {
		DisplayName: 地晶裂碎大剑
		Tooltip:
			'''
			源自地核晶体之力，招招迸发熔岩爆裂
			命中时引发熔岩晶爆，撼动大地
			'''
	}

	QuadraseaCataclysmicEdge: {
		DisplayName: 四海灾变锋刃
		Tooltip:
			'''
			汇聚四海之威，斩出绿珊瑚三重剑波
			挥击时发射三道珊瑚海洋剑气
			'''
	}

	VortexPrimordialStain: {
		DisplayName: 漩流玄印权杖
		Tooltip:
			'''
			蕴含漩涡原初之力，发射青珊瑚追踪光球
			光球起初蜿蜒飞行，随后追踪最近的敌人
			'''
	}

	LuminanceStellarCannon: {
		DisplayName: 星光凝聚炮
		Tooltip:
			'''
			集星光之能于炮膛，射出穿透白蓝能束
			命中后引发星能爆裂，照亮黑暗
			'''
	}

	LuminousIrisAnnihilator: {
		DisplayName: 耀虹湮灭手炮
		Tooltip:
			'''
			凝聚万彩虹光，发射毁天灭地的金色炮弹
			命中后引发漫天金光爆炸
			'''
	}

	TwilightGlazeGreatbow: {
		DisplayName: 暮光流华大弓
		Tooltip:
			'''
			暮色流华之弓，无论何种箭矢皆化为珊瑚海洋之箭
			发射穿透青珊瑚箭，命中后绽放海洋光爆
			'''
	}

	StarfireAnnihilator: {
		DisplayName: 星火寂灭重炮
		Tooltip:
			'''
			引导珊瑚星火的力量，发射能穿透多个敌人的高速星弹
			命中时引爆出珊瑚青色的星辰爆炸
			'''
	}

	VaultshadeVoidshot: {
		DisplayName: 穹闪破空狙击
		Tooltip:
			'''
			一把褐色的科技狙击枪，发射随着飞行不断扩大的虚空弹
			命中时触发紫色的虚空内爆，将敌人吸入其中
			'''
	}

	ArgentPulseObliterator: {
		DisplayName: 银脉湮灭冲锋枪
		Tooltip: 高速连射银蓝能量脉冲弹，每8发触发超载三连矢
	}

	ArcaneRepulsionArray: {
		DisplayName: 圣械幽蓝斥力阵
		Tooltip:
			'''
			召唤金蓝相间的龙鳞无人机进行巡逻，并向敌人发射穿透性激光
