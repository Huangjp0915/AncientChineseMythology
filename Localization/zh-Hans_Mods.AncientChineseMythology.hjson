	}

	AzureTorrentBlades: {
		DisplayName: 列斩幽蓝剑意
		Tooltip:
			'''
			召唤悬浮在剑鞘中的幽蓝剑意，随后带着蓝色光辉旋转冲出
			可召唤多把剑刃；它们在高速旋转时造成接触伤害
