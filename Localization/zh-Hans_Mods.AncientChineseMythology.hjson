Items: {
	RuyiJinguBang: {
		DisplayName: 如意金箍棒
		Tooltip:
			'''
			传说中的如意金箍棒
			有了它，你似乎会吸引某些人的注意
			东海镇海之宝，重一万三千五百斤
			'''
	}

	WoodenStick: {
		DisplayName: 木棍
		Tooltip:
			'''
			唐僧赠送的武器
			据说是由某个猴子让他交给有缘人的
			左键两段连击，右键"如意戳"——棍会随心伸长刺出
			'''
	}

	GemStick: {
		DisplayName: 宝石棍
		Tooltip:
			'''
			被它敲到的人身价得暴涨了
			命中绽出棱光碎片，右键"棱光回旋"甩出七彩流光
			'''
	}

	GoldenStick: {
		DisplayName: 金棍
		Tooltip:
			'''
			这根棍子现在看起来更贵重了？
			每四挥引出"金光三连突"；右键掷棍——离手仍如臂使指
			'''
	}

	IronStick: {
		DisplayName: 铁棍
		Tooltip:
			'''
			这根铁棍很重，
			你得学会控制它
			三段连击收于一记重抡；右键拄棍撑地借力跃起
			'''
	}

	RuyiStick: {
		DisplayName: 如意棍
		Tooltip:
			'''
			这根棍子……
			仿佛看到了某位故人
			每五挥棍身如意巨大化、击落敌弹
			按住右键蓄力"定海神针"，松开时天降巨针砸落
			'''
	}

	TrueRuyiStick: {
		Tooltip:
			'''
			这根棍子……
			好大的猴骚味
			双头回环两端皆可伤敌；定海神针蓄力更快、落地分出侧针
			'''
		DisplayName: 真·如意棍
	}

	SkyKey: {
		DisplayName: 天界之钥
		Tooltip: 据说这个可以通往三十三重天
	}

	YaoQiFragment: {
		DisplayName: 妖气碎片
		Tooltip:
			'''
			一块散发着神秘妖气的碎片
			材料
			'''
	}

	ScrapElixir: {
		DisplayName: 废丹
		Tooltip:
			'''
			短暂恢复一定血量

			'''
	}

	ElixirFurnaceItem: {
		Tooltip: 太上老君随手制作的一个炉子
		DisplayName: 炼丹炉
	}

	XuePoDan: {
		DisplayName: 血魄丹
		Tooltip: 短时间内提升你的最大生命值，但是有危险的后遗症
	}

	NingShenDan: {
		DisplayName: 凝神丹
		Tooltip: 短时间内提升你的最大法力值，但是有危险的后遗症
	}

	XuanGangDan: {
		DisplayName: 玄罡丹
		Tooltip: 短时间内提升你的防御力，但是有危险的后遗症
	}

	PoJunDan: {
		DisplayName: 破军丹
		Tooltip: 短时间内提升你的攻击力，但是有危险的后遗症
	}

	TeleportationItem: {
		DisplayName: 漩涡之门
		Tooltip: 据说这个可以通往地府
	}

	DogCharm: {
		DisplayName: 狗符咒
		Tooltip:
			'''
			掷出犬符，灵犬扑咬敌人后咬定不放，持续撕咬
			全场至多三头犬灵
			"义犬既出，死咬不松口"
			'''
	}

	ChickenCharm: {
		DisplayName: 鸡符咒
		Tooltip:
			'''
			掷出鸡符，金鸡昂首三声啼鸣，扩散三圈破晓冲击环
			"雄鸡一唱天下白"
			'''
	}

	HorseCharm: {
		DisplayName: 马符咒
		Tooltip:
			'''
			掷出马符，落点扬起三波九骑奔雷马灵，横贯战场
			"万马奔腾，势不可挡"
			'''
	}

	CowCharm: {
		DisplayName: 牛符咒
		Tooltip:
			'''
			掷出牛符，蛮牛刨地蓄势后贯穿冲撞，重击退一路碾过
			"九牛之力，聚于一冲"
			'''
	}

	SnakeCharm: {
		DisplayName: 蛇符咒
		Tooltip:
			'''
			掷出蛇符，灵蛇蜿蜒追踪；对同一敌人的第三口注入蛇缠剧毒
			右键蛇蜕：短暂匿踪，其间掷出的蛇灵首口为伏击重创
			"打草惊蛇者，反为蛇噬"
			'''
	}

	RabbitCharm: {
		DisplayName: 兔符咒
		Tooltip:
			'''
			掷出兔符，玉兔灵瞬步三连击，第三击捣月下砸
			"月宫捣药杵，落地碎千钧"
			'''
	}

	DragonCharm: {
		DisplayName: 龙符咒
		Tooltip:
			'''
			以血为引(消耗12点生命)掷出龙符，血绘雷龙蜿蜒扑向落点，雷印起爆
			每第四张符将召来雷龙劫：巨龙贯穿天地，劫雷偿还鲜血
			生命高于60时才能画符
			"朱砂调血，一笔成龙"
			'''
		JieReady: 下一张符将召来雷龙劫！
	}

	PigCharm: {
		DisplayName: 猪符咒
		Tooltip:
			'''
			引导贪食洪流，喂得越久猪灵越贪，伤害与束宽随之上涨
			吃饱后松手，在洪流尽头打一个毁灭性的饱嗝
			"能吃是福"
			'''
	}

	StrangeStone: {
		DisplayName: 奇怪的石头
		Tooltip: 里面有一股神奇的能量
	}

	BronzeIngot: {
		DisplayName: 青铜锭
		Tooltip: 小心有毒
	}

	Cuprite: {
		DisplayName: 赤铜锭
		Tooltip: 烫烫烫
	}

	BlackBearStaff: {
		DisplayName: 黑熊法杖
		Tooltip:
			'''
			召唤一只黑熊幼灵为你作战
			幼灵蓄势后以黑风猛扑, 落掌震击四方
			每第四掌为金冠怒击
			“黑风山的小家伙, 头顶的金冠看起来很合适”
			'''
	}

	BlackBearSword: {
		DisplayName: 勇士金剑
		Tooltip:
			'''
			命中将敌人蜜渍, 使其受到的伤害提高
			每第三挥, 从身后黑风中扑出一道黑风熊掌
			“仅献给能够拔起它的人……”
			'''
	}

	BlackBearBow: {
		DisplayName: 金金弓
		Tooltip:
			'''
			黑风驱矢：射出的箭化为黑风箭
			每第五箭为蜂蜜重矢，迟缓敌人并迸溅蜜滴
			“金光闪闪？”
			'''
	}

	BronzeSword: {
		DisplayName: 青铜剑
		Tooltip:
			'''
			“剑身闪烁着瘆人的绿芒……”
			击中敌人使敌人中毒
			断金: 处决生命低于 12% 的普通敌人, 对残血首领增伤 15%
			'''
	}

	CrimsonbronzeSword: {
		DisplayName: 赤铜剑
		Tooltip:
			'''
			“火焰包裹着剑身……”
			左键攻击点燃敌人
			按住右键入炉蓄力, 松手挥出重斩 —— 蓄满一/二/三级各有白热闪提示
			二级以上出炉附带熔火溅珠
