Buffs: {
	KarmaAwakenBuff: {
		DisplayName: 业劫觉醒
		Description: 业障满溢——亡魂EX武器显露真形
	}

	DivineWoodRootedBuff: {
		DisplayName: 生根
		Description: 神木根须缠体——生命持续流逝；小心收割者引爆年轮绽放
	}

	HoqingFireSummonBuff: {
		DisplayName: 幽火仪仗
		Description: 仪仗幽灯为你而战
	}

	GluttonousSatietyBuff: {
		DisplayName: 饱食
		Description: 肉旋吃饱了：膨胀、更痛、更贪
	}

	AoyuanChill: {
		DisplayName: 永冻
		Description: 寒冰地痕使你减速；叠满三层将被彻底冻结
	}

	AoyuanDeepFreeze: {
		DisplayName: 深度冻结
		Description: 被冰封其中，无法移动
	}

