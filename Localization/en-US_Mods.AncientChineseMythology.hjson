	}

	FlamecoilChakram: {
		DisplayName: Flamecoil Chakram
		Tooltip: Twin flame chakrams weave outward and return for a second hit · Ignites foes · 355 melee damage
	}

	InfernoDragonSpear: {
		DisplayName: Inferno Dragon Spear
		Tooltip: Flame-pattern thrust, scorch-wind trail, ignited stacks (up to 8) · 350 melee damage
	}

	MeteorCallerStaff: {
		DisplayName: Meteor Caller Staff
		Tooltip: Channel a dragon sigil at the cursor, then rain multiple flame meteors · 365 magic damage
	}

	LightningEdictTome: {
		DisplayName: Lightning Edict Tome
		Tooltip: Deploys a talisman lightning array at the cursor and fires tracking thunder seals; the array strikes periodically and hits call down bolts · 385 magic damage
	}

	StormchainWhip: {
		DisplayName: Stormchain Whip
		Tooltip: Electrifies struck foes and chains lightning between hit targets · 375 summon whip damage
	}

	TempestRepeater: {
		DisplayName: Tempest Repeater
		Tooltip: Fires a triple volley of storm bolts; hits stack storm marks that detonate · 380 ranged damage
	}

	ThunderlordHalberd: {
		DisplayName: Thunderlord Halberd
		Tooltip: Thunder halberd thrust with chain lightning arcs · 370 melee damage
	}

	BlizzardPiercer: {
		DisplayName: Blizzard Piercer
		Tooltip: Blizzard cloud-piercing arrows stack frost pierces; every 6 pierces, the next shot unleashes an empowered blizzard surge · 375 ranged damage
	}

	GlacialDragonblade: {
		DisplayName: Glacial Dragonblade
		Tooltip: A swift blade forged from the West Sea Dragon King's frost scales\nSwing to release glacial dragon arc slashes; every third strike unleashes an empowered wave\nHits inflict Frostburn and frost slow · 355 melee damage
	}

	PermafrostTrident: {
		DisplayName: Permafrost Trident
		Tooltip: A West Sea trident forged from permafrost tide and ice crystal\nThrust, then throw; the trident returns automatically\nReturn path deals bonus damage and inflicts frost slow · 360 melee damage
	}

	SoulPiercingArc: {
		DisplayName: Soul Piercing Arc
		Tooltip:
			'''
			Argus soul-piercing bow strung with iris pupil threads
			Converts arrows into homing iris arrows that stack Weakness Marks; full stacks detonate for a soul pierce burst
			Detonations scatter iris shards that home onto other enemies' weak points
			'''
	}

	BlackTortoiseShield: {
		DisplayName: Black Tortoise Shield
		Tooltip:
			'''
			Left-click shield bash · Right-click block reduces damage 25% and reflects 115% of incoming damage
			A successful block-reflect erupts a Black Tortoise ward that knocks back and frostburns surrounding foes · 1550 melee damage
			'''
	}

	FourSymbolsTablet: {
		DisplayName: Four Symbols Tablet
		Tooltip:
			'''
			Raise the tablet to begin the Rite of the Four Symbols
			Azure Dragon (E), Vermilion Bird (S), White Tiger (W) and Black Tortoise (N) descend in turn
			The next cardinal beast wakes only after the last has fallen
			Cannot be used while a sacred beast is present
			'''
	}

	PhoenixFlameStaff: {
		DisplayName: Phoenix Flame Staff
		Tooltip:
			'''
			Launches phoenix flame orbs that rebirth into homing embers on hit or expiry
			Every fifth cast dives a nirvana phoenix that pierces, burns, and bursts into a flurry of fire feathers · 1480 magic damage
			'''
	}

	ThunderclapLongbow: {
		DisplayName: Thunderclap Longbow
		Tooltip:
			'''
			Piercing thunder arrows · Hold to drum-charge and release an infinite-pierce sky-bolt
			Hits call down a sky lightning column; fully-charged bolts also chain a strike to a nearby foe · 1550 ranged damage
			'''
	}

	WhiteTigerClaws: {
		DisplayName: White Tiger Claws
		Tooltip:
			'''
			Baihu tiger claws · 1500 melee damage
			Four-hit claw combo with escalating bleed
			Finisher releases three silver claw rip waves
			Right-click Tiger Pounce: lunge toward the cursor, deep-rending foes with three claws along the way
			'''
	}

	WindserpentDao: {
		DisplayName: Windserpent Dao
		Tooltip:
			'''
			Slashes release homing wind-serpent blades; every fourth strike summons a homing tornado
			Right-click dashes as a wind serpent, tearing five slipstream slashes along the path · 1520 melee damage
			'''
	}

	TreasurePagodaCharm: {
		DisplayName: Treasure Pagoda Charm
		Tooltip: 15% damage reduction, +10 defense, 100% thorns · On hit, summons treasure pagoda phantoms that retaliate · Higher Fortune makes them stronger and more numerous (up to three)
	}

	TreasurePagodaStaff: {
		DisplayName: Treasure Pagoda Staff
		Tooltip:
			'''
			Summons stacking treasure pagodas at the cursor, up to six tiers
			Pick up coins to empower pagodas; pagodas also gather Fortune by suppressing foes
			Tier 4+ pagodas fire homing fortune coins that hunt enemies
			1320 magic damage
			'''
	}

	SinSeveringBlade: {
