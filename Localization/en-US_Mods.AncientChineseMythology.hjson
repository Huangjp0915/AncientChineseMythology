	DogCharm: {
		DisplayName: Dog Charm
		Tooltip:
			'''
			Throws a hound talisman; the spirit hound latches onto an enemy and keeps mauling it
			Up to three hounds may hunt at once
			"Once loosed, the loyal hound never lets go"
			'''
	}

	ChickenCharm: {
		DisplayName: Chicken Charm
		Tooltip:
			'''
			Throws a rooster talisman; the golden rooster crows thrice, each crow releasing a dawn shockwave ring
			"One crow, and the world turns white"
			'''
	}

	HorseCharm: {
		DisplayName: Horse Charm
		Tooltip:
			'''
			Throws a horse talisman; three waves of three thunder-steeds stampede across the battlefield
			"Ten thousand horses, unstoppable"
			'''
	}

	CowCharm: {
		DisplayName: Cow Charm
		Tooltip:
			'''
			Throws an ox talisman; the great ox paws the earth, then rams through everything in its path
			"The strength of nine oxen, spent in one charge"
			'''
	}

	SnakeCharm: {
		DisplayName: Snake Charm
		Tooltip:
			'''
			Throws a serpent talisman; the serpent spirit weaves toward foes — its third bite on the same enemy constricts with venom
			Right click to molt: briefly slip attention, and serpents thrown meanwhile ambush with a vicious first bite
			"Startle the snake in the grass, and be bitten for it"
			'''
	}

	RabbitCharm: {
		DisplayName: Rabbit Charm
		Tooltip:
			'''
			Throws a rabbit talisman; the moon rabbit blinks between foes with a three-strike combo, ending in a moon-pounding slam
			"The jade pestle falls, and mountains crack"
			'''
	}

	DragonCharm: {
		DisplayName: Dragon Charm
		Tooltip:
			'''
			Draws a talisman in blood (costs 12 life); a blood-inked thunder dragon pounces on the target and detonates its seal
			Every fourth talisman calls down the Dragon Tribulation: a colossal dragon splits the sky, and its bolts repay your blood
			Requires more than 60 life to use
			"Blood in the cinnabar; one stroke births the dragon"
			'''
		JieReady: The next talisman calls down the Dragon Tribulation!
	}

	PigCharm: {
		DisplayName: Pig Charm
		Tooltip:
			'''
			Channels a gluttonous torrent; the longer the pig spirit feeds, the greedier it grows — damage and beam width swell
			Release when full to end the feast with a devastating burp
			"To eat well is a blessing"
			'''
	}

