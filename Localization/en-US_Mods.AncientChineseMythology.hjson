	UnderworldInvasionSummon: {
		DisplayName: Nether Realm Token
		Tooltip:
			'''
			Summons the Underworld Invasion (20 waves)
			Four ghost gates will open, undead spirits swarm forth
			Defeat all underworld enemies to end the event
			'''
	}

	CodexofFate: {
		DisplayName: Codex of Fate
		Tooltip:
			'''
			A netherworld codex recording the fates and karma of all beings
			Revenant weapon hits mark foes with karma; at seven stacks, Yama's verdict descends
			Every fourth cast turns to the vermilion page, adding a rebuke that chains lightning to nearby foes
			Open it, and you shall see their endings
			(Perhaps yours as well.)
			'''
	}

	JudgesSoulhook: {
		DisplayName: Judge's Soulhook
		Tooltip:
			'''
			The judge's sentence, dealt in three thrusts - pierce, lunge, and the soul-hooking rake
			The third strike drags sinners toward you and rips at their soul
			Hits siphon life; hooking a soul awaiting verdict feasts deeply
			'''
	}

	KarmasMirrorBlade: {
		DisplayName: Karma's Mirror Blade
		Tooltip:
			'''
			A blade that mirrors sin like the Karma Mirror, always returning
			Hits in flight store sin within the mirror
			When brimming, the next throw becomes a verdict cast: twin reflections follow, and all stored sin is repaid at once
			Your foes will see their gravest sins within the mirror
			'''
	}

	NetherfireBlunderbuss: {
		DisplayName: Netherfire Blunderbuss
		Tooltip:
			'''
			Fires netherfire that burns flesh and soul alike
			A fixed five-pellet fan - the swiftest way to stack karma before judgment
			Every fourth shot overcharges both barrels into an eight-pellet blast
			'''
	}

	NetherRockSoulbomb: {
		DisplayName: Nether Rock Soulbomb
		Tooltip:
			'''
			A soul-detonating bomb hewn from nether rock
			Use again while one is deployed to detonate it remotely
			Explosions leave a soul-scorching field and strike karma-laden foes harder
			'''
	}

	StaveofNetherflow: {
		DisplayName: Stave of Netherflow
		Tooltip:
			'''
			A stave channeling the flow of the Yellow Springs
			Its winding river-orb blooms into a nether vortex where it strikes
			The vortex drags souls inward, burns them, and returns their life to the wielder
			'''
	}

	UnderworldSoulguide: {
		DisplayName: Underworld Soulguide
		Tooltip:
			'''
			A bow that ferries souls to the Yellow Springs
			Arrows fiercely home in on marked (karma-bearing) souls
			Every fourth draw looses twin arrows; slain marked souls yield ferrying wisps
			'''
	}

	YamasSeverance: {
		DisplayName: Yama's Severance
		Tooltip:
			'''
			The greatblade with which Yama severs the karma of all beings
			Left click for a three-hit combo ending in an overhead cleave that releases a severance wave
			Right click for the Verdict Iai: dash-slash through; karma-laden foes suffer the severance verdict
			Marked stragglers at death's door are executed outright (non-boss only)
			It needs no sheath, for karma never rests
			'''
	}

	YamasDeicide: {
		DisplayName: Yama's Deicide
		Tooltip:
			'''
			The ultimate blade that severs karma and slays gods
			Held three-hit combo - chop, reverse slash, full spin - each hurling a slash wave
			Executes non-boss enemies below 15% health, tearing open a deicide rift
			While Karma-Awakened, the first stroke becomes Yama's Single Stroke
			'''
	}

	DamnedSoulguide: {
		DisplayName: Damned Soulguide
		Tooltip:
			'''
			Guides the souls of those damned to ten thousand calamities
			Fires 3 homing soul arrows; hits stack Soul Marks on the target
			At 6 marks, a Yellow Springs ferry pillar crashes down upon them
			Awakened form: arrows split into homing soul shards on hit
			'''
	}

	SoulEatingCannon: {
		DisplayName: Soul-Eating Cannon
		Tooltip:
			'''
			A heavy nether cannon that devours souls
			Sprays 12 soul-eating bullets; hits and kills feed the Soul Chamber
			Right click consumes all chambers to unleash a Soul Maw Blast
			Awakened form: tighter spread and doubled soul intake
			'''
	}

	InfinityKarmaBlade: {
		DisplayName: Infinity Karma Blade
		Tooltip:
			'''
			A blade of endless karmic cycles, like the Avici Hell itself
			The blade ricochets between enemies, karmic flame growing with each bounce
			Catch it to gain Karma Edges; at 3, hurl the Avici Wheel Blade
			Awakened form: throws three blades with extra bounces
			Hits build Karma; overflow triggers an 8s Karmic Awakening
			'''
	}

	OblivionSoulhook: {
		DisplayName: Oblivion Soulhook
		Tooltip:
			'''
			The Judge's spear of ultimate oblivion and death
			Three-thrust combo; the third is a Soul-Hook Impale with doubled lifesteal
			Massive thrust reach; kills trigger an Oblivion Burst
			Awakened form: 30% faster thrusts that loose soul waves
			'''
	}

	CodexofMyriadDemons: {
		DisplayName: Codex of Myriad Demons
		Tooltip:
			'''
			The ultimate codex recording the karma of ten thousand demons
			Casts heavy demon runes; every 5th cast summons a Demon Lord Sigil
			The Sigil's first hit unfolds the Myriad Demon array, chaining lightning to 5 foes
			Awakened form: shadow runes strike from behind on every cast
			'''
	}

	StaveofNetherEclipse: {
		DisplayName: Stave of Nether-Eclipse
		Tooltip:
			'''
			A stave channeling the power of Yellow Spring's oblivion
			Fires an eclipse orb flanked by two attendants; the orb unfolds a Nether Net
			The net slows and erodes souls, then collapses in a lunar-eclipse burst
			Awakened form: wider net, faster erosion
			'''
	}

	SoulShatteringUnderworldBomb: {
		DisplayName: Soul-Shattering Underworld Bomb
		Tooltip:
			'''
			A nether-rock bomb that shatters souls and opens the gates of Yellow Spring
			The blast tears open a Gate of Yellow Springs that spews 3 cluster bombs
			No soul can escape the gate once opened
			Awakened form: the gate spews 5 clusters
			'''
	}

	CelestialImperatorGreatblade: {
		DisplayName: Celestial Imperator Greatblade
		Tooltip:
			'''
			The blade of myriad calamities forged by the Yin Emperor, severing all cycles of reincarnation
			Hold to chain a 3-hit combo: cleave and uppercut each hurl 3 Imperator Slashes
			The third strike, "Decree of Myriad Calamity", hurls a great slash and tears a void vortex at the cursor
			Third-strike crits unleash chained judgment on all enemies within 600 range
			Instantly obliterates non-boss enemies below 25% health
			'''
	}

	PrimordialChaosDeicideBow: {
		DisplayName: Primordial Chaos Deicide Bow
		Tooltip:
			'''
			A deicide bow condensed from primordial chaos energy, requires no mundane arrows
			Hold to draw through 3 charge tiers, condensing a Myriad Feather array behind you (up to 14)
			Release to loose the deicide arrow; the feather array follows in a rolling volley
			A fully-drawn arrow tears open a Chaos Gate on impact, raining fallen feathers
			'''
	}

	HellwyrmAnnihilationCannon: {
		DisplayName: Hellwyrm Annihilation Cannon
		Tooltip:
			'''
			The ultimate cannon sealed with a hell dragon's breath, requires no ammo
			Hold to inhale nether souls through 3 charge tiers, release to exhale an expanding nether-flame breath
			Deeper charge, mightier breath: a full breath bears the Hellwyrm's soul-head at its crest
			Hits brand Annihilation Marks that detonate after 2s (full-breath marks deal x2.5)
			'''
	}

	AbyssalFrostJudgmentChakram: {
		DisplayName: Abyssal Frost Judgment Chakram
		Tooltip:
			'''
			The Judgment Wheel of the Nine Hells, condensed from abyssal frost
			Orbits the wielder and auto-charges nearby enemies
			Throw again while deployed to issue a Decree Dash: the wheel rears back, then snaps toward your cursor
			Every 5th hit triggers Nine-Nether Judgment: the wheel halts, tearing a void rift that freezes all enemies in range
			Inflicts Frostburn, Frozen, and Broken Armor on hit
			'''
	}

	VoidDamnationSoulpiercerSpear: {
		DisplayName: Void Damnation Soulpiercer Spear
		Tooltip:
			'''
			The spear of void damnation that pierces through eternal calamity
			Hold to thrust continuously; every 4th thrust becomes Eternal Soulpierce with longer windup and reach
			Eternal Soulpierce tears a Void Rift along its path, pulsing to drag enemies onto the line
			Ignores enemy defense and heals on every strike; the great thrust heals double
			Kills shatter souls into a chained void eruption
			'''
	}

	NightmareRashomonMyriadCurseTome: {
		DisplayName: Nightmare Rashomon Myriad-Curse Tome
		Tooltip:
			'''
			A forbidden tome recording primordial nightmares and infinite curses
			Summons a single Rashomon Gate at the cursor, lasting 5 seconds
			The gate pulls enemies in and looses nightmare tendrils that stack curses (up to 8)
			Cast again while the gate stands to slam it shut, reckoning all cursed foes per stack
			'''
	}

	NetherworldArchonFateScepter: {
		DisplayName: Netherworld Archon Fate Scepter
		Tooltip:
			'''
			The scepter of fate wielded by the Supreme Judge of the Netherworld
			Left click fires twin helix soul-hook orbs that brand Fate Marks (up to 6 stacks, recording damage dealt)
			Right click passes the Fate Verdict: imperial decrees descend, striking each mark for accumulated damage x (1.2 + 0.15 per stack)
			Unjudged marks self-detonate after 3 seconds for accumulated damage x1.5
			'''
	}

	ShadowOblivionSingularityBomb: {
		DisplayName: Shadow Oblivion Singularity Bomb
		Tooltip:
			'''
			The ultimate annihilation bomb condensed from void singularity
			Creates a 1-second gravity well on impact, then implodes catastrophically
			Use again while a well charges to detonate early (60%~100% power by charge)
			Killed enemies spawn chain-reaction singularities
			'''
	}

	WoodlandGreatsword: {
		DisplayName: Woodland Greatsword
		Tooltip:
			'''
			A living greatsword woven from woodland branches and vines, swings in a three-hit combo
			The third slam erupts root spikes along the ground
			Hits build Vigor; at full Vigor the slam becomes a "Verdant Burst" root ring
			Has a chance to inflict Poisoned on hit
			'''
	}

	RootBoomerang: {
		DisplayName: Root Boomerang
		Tooltip:
			'''
			A boomerang crafted from twisted tree roots
			Catch it on return to stack Grind, boosting damage and throw speed
			Striking two enemies in one flight sharpens its return
			'''
	}

	VineHunterBow: {
		DisplayName: Vine Hunter Bow
		Tooltip:
			'''
			A bow woven from living vines
			Every fourth arrow becomes a vine arrow that plants a mark
			Hitting a marked target lashes it with a vine whip from below
			'''
	}

	DeadwoodMusket: {
		DisplayName: Deadwood Musket
		Tooltip:
			'''
			A three-round deadwood musket, consumes no ammo
			The third round is a scatter blast of four acorn pellets with heavy recoil
			Acorns splinter into wooden shard shrapnel
			'''
	}

	EmeraldTwigStaff: {
		DisplayName: Emerald Twig Staff
		Tooltip:
			'''
			A twig staff inlaid with emeralds
			Hits embed emerald shards into the target, up to three
			The next hit on a fully studded target triggers a resonance burst
			'''
	}

	NatureGrimoire: {
		DisplayName: Nature Grimoire
		Tooltip:
			'''
			An ancient grimoire recording nature's power, each cast turns a page
			The fifth page blooms a ring of leaf blades that unfolds and closes back in
			The bloom leaves a verdant field that slowly heals players inside
			Hits have a chance to inflict Poisoned
			'''
	}

	MossBomb: {
		DisplayName: Moss Bomb
		Tooltip:
			'''
			An explosive wrapped in glowing moss
			Bounces off the ground onto a short fuse; direct hits detonate instantly
			The blast releases a poison mushroom cloud and spore buds that linger
			'''
	}

	DivineWoodBomb: {
		DisplayName: Divine Wood Bomb
		Tooltip:
			'''
			An explosive seed that grows
			Hitting the ground plants it, erupting three waves of root spikes; the last wave detonates Rooted
			Hitting an enemy makes it parasitize and swell, planting 3 Rooted stacks and detonating on bloom
			Times out mid-air with a blooming burst and homing vine shards
			'''
	}

	DivineWoodGreatblade: {
		DisplayName: Divine Wood Greatblade
		Tooltip:
			'''
			A massive blade condensed from millennia-old divine wood, sap-light coursing through it
			Three-hit combo: the first two swings plant Rooted, the third growth-ring cleave detonates Rooted and releases a wave
			Right click to channel "Jianmu Rising": three towering pillars erupt ahead (9s cooldown)
			'''
	}

	DivineWoodGyratingLeaf: {
		DisplayName: Divine Wood Gyrating Leaf
		Tooltip:
			'''
			A spinning blade condensed from divine wood leaves
			Hold after throwing to anchor it as a growth-ring saw that plants Rooted with each grind
			Release to recall at high speed: 1.5x damage, detonating Rooted along the way
			Every 5 hits triggers Nature's Verdict, releasing a petal barrage
			'''
	}

	DivineWoodLongbow: {
		DisplayName: Divine Wood Longbow
		Tooltip:
			'''
			A charge longbow woven from living wood and spirit vines
			Quick shots fire leaf bolts; half charge looses a triple volley with spiral leaf escorts, all planting Rooted
			Full charge fires the Forest Piercer: a massive arrow that pierces everything and detonates Rooted on each victim
			'''
	}

	DivineWoodMusket: {
		DisplayName: Divine Wood Musket
		Tooltip:
			'''
			A three-round burst musket driven by divine wood mechanisms
			Each trigger pull fires three thorn needles that plant Rooted
			Every 9th shot loads a seed mortar: on impact a row of root spikes erupts to harvest Rooted
			'''
	}

	DivineWoodScepter: {
		DisplayName: Divine Wood Scepter
		Tooltip:
			'''
			A scepter carved from the heart of an ancient divine tree
			Lashes out a vine whip: the tip plants 2 Rooted stacks, the body plants 1
			Every 4th lash is a heavy crack: bonus damage, the tip detonates Rooted and leaves a thorn patch
			'''
	}

	DivineWoodTome: {
		DisplayName: Divine Wood Tome
		Tooltip:
			'''
			An ancient tome recording the spirit of all trees
			Triple chant: two leaf fans that plant Rooted, then a canopy volley with a piercing lotus that detonates Rooted
			Right click (5s cooldown) to unfurl a growth-ring circle at the cursor, detonating Rooted on all enemies within
			'''
	}

	TheNaturalAxe: {
		DisplayName: The Natural Axe
		Tooltip:
			'''
			A divine relic left behind by Dazheng, ancestor of all trees
			Left-click to swing as a powerful axe
			Right-click to plant tree saplings on nearby ground
			'''
	}

	ArrogantDivineSylvan: {
		DisplayName: Arrogant Divine Sylvan
		Tooltip:
			'''
			Divine wood essence crystallized over eons within Dazheng
			Contains immortal life force, softly radiating an emerald-gold glow
			'''
	}

	ArrogantDivineSylvanGreatblade: {
		DisplayName: Arrogant Divine Sylvan Greatblade
		Tooltip:
			'''
			The ultimate greatblade forged from the essence of the eternal Divine Sylvan
			3-hit combo cycle: Sweep → Upswing → Heavenly Slam
			Sweep and Upswing carve growth ring brands into enemies
			Heavenly Slam quakes the earth, detonating all brands in the area
			Ring upon ring, one slash to bloom them all
			'''
	}

	ArrogantDivineSylvanBomb: {
		DisplayName: Arrogant Divine Sylvan World Seed
		Tooltip:
			'''
			The ultimate explosive seed containing the essence of the World Tree
			Quick-toss to seed the field, or hold to charge a Mother Seed
			Splits mid-flight into five child seeds; vine serpents brand enemies with growth rings
			The Mother Seed's blast detonates all brands in the area
			A myriad of blooms erupt, changing the color of heaven and earth
			'''
	}

	ArrogantDivineSylvanBow: {
		DisplayName: Arrogant Divine Sylvan Bow
		Tooltip:
			'''
			The ultimate longbow bent from the trunk of the World Tree
			Converts arrows into infinitely-piercing vine lances
			Each arrow flies with four DNA double-helix leaves; hits carve growth ring brands
			Every 4th shot condenses a World Tree Arrow: gather, hush, burst
			The World Tree Arrow detonates brands on hit
			'''
	}

	ArrogantDivineSylvanChakram: {
		DisplayName: Arrogant Divine Sylvan Leaf Storm
		Tooltip:
			'''
			The ultimate chakram condensed from ancient divine leaf veins
			Unleashes a spiral storm at its landing point
			The kill zone is the spinning golden-emerald leaf ring; the eye of the storm is safe
			Hold to sustain the storm; the ring pulses, flinging whirlwind leaves
			Release to implode, detonating every growth ring brand in the area
			Return trip deals 2x damage; catching it lands with real impact
			'''
	}

	ArrogantDivineSylvanMusket: {
		DisplayName: Arrogant Divine Sylvan Musket
		Tooltip:
			'''
			The ultimate rapid-fire weapon driven by World Tree golden thorn mechanisms
			True five-round bursts with recoil on every shot
			Hits carve growth ring brands and chain-bounce between enemies
			Every 25th shot lobs three splitting seed mortars that detonate nearby brands
			Detonating 3+ ring stacks at once triggers Thorn Fury: eight homing thorns bloom out
			'''
	}

	ArrogantDivineSylvanStaff: {
		DisplayName: Arrogant Divine Sylvan Staff
		Tooltip:
			'''
			The ultimate scepter carved from the heart of the ten-thousand-year Divine Sylvan
			Hold to steer the vine chain whip toward your cursor — the whole chain deals damage
			Whip hits carve growth ring brands; the chain sprouts homing tendrils
			At full stretch the whip snaps shut: a Vine Nova detonates all brands around it
			'''
	}

	ArrogantDivineSylvanTome: {
		DisplayName: Arrogant Divine Sylvan Tome
		Tooltip:
			'''
			An ancient supreme treasure recording the spiritual essence of all trees
			Releases seven great golden-emerald leaf blades in a fan spread
			Leaves spiral, then home in; hits carve growth ring brands
			Every 6th use conjures a Leaf Storm Vortex: gravitational pull, pulsing brand detonations
			Blooming brands scatter dancing petals
			'''
	}

	WoodenLeafPendant: {
		DisplayName: Wooden Leaf Pendant
		Tooltip: Radiates a faint natural aura, granting minor life regeneration
	}

	VineWovenShield: {
		DisplayName: Vine-Woven Shield
		Tooltip:
			'''
			Woven from rough branches and resilient vines
			Increases defense by 1
			Reflects minor thorn damage when hit by contact damage
			'''
	}

	ForestCrystalAmulet: {
		DisplayName: Forest Crystal Amulet
		Tooltip:
			'''
			A rustic amulet infused with forest crystal magic
			Increases maximum mana by 20
			Reduces mana cost by 3%
			'''
	}

	BarkReinforcedGlove: {
		DisplayName: Bark-Reinforced Glove
		Tooltip:
			'''
			A bit rough on the hands, but great for wrist protection
			Increases melee and tool swing speed by 5%
			'''
	}

	WoodlandBarkBoots: {
		DisplayName: Woodland Bark Boots
		Tooltip:
			'''
			Crafted from thick bark and moss, silent on any terrain
			Increases movement speed by 5%
			Reduces fall damage when standing on grass or dirt
			'''
	}

	ProfaneDismemberer: {
		DisplayName: Profane Dismemberer
		Tooltip:
			'''
			A horrific greatsword forged from profane flesh
			Three-hit combo: slash, upswing, down-chop, each loosing a writhing flesh wave
			Blade hits apply Vivisection Marks; the down-chop applies two and shakes the ground
			At five marks a gazing eye harvests the victim in a lethal burst that heals you
			'''
	}

	GluttonousFleshrang: {
		DisplayName: Gluttonous Fleshrang
		Tooltip:
			'''
			A boomerang wrapped in living flesh
			Return hit deals 80% more damage, leeches life and applies Vivisection Marks
			Catch it after 3+ hits in one flight to become Satiated: engorged, hungrier, deadlier
			Every 4 hits releases homing flesh tendrils
			'''
	}

	TwitchingTendonBow: {
		DisplayName: Twitching Tendon Bow
		Tooltip:
			'''
			An eerie longbow strung with twitching tendons; hold to draw
			A full-draw spasm looses a piercing spine bolt with twin spiral blades
			Spasm bolts burst ribs on impact and apply a Vivisection Mark
			Every third full draw conjures a homing aberrant eyeball
			'''
	}

	VisceraSpitter: {
		DisplayName: Viscera Spitter
		Tooltip:
			'''
			A writhing flesh-barrel gun spitting high-speed blood bullets
			Five-round bursts of penetrating blood projectiles
			Every 25th shot vomits a massive viscera glob - the last five shots pulse faster in warning
			Glob impacts apply Vivisection Marks and burst into homing tendrils
			'''
	}

	BurstingTumorBomb: {
		DisplayName: Bursting Tumor Bomb
		Tooltip:
			'''
			A pressurized swollen tumor - hold the attack button to let it gestate
			The longer it gestates, the greater its damage, fragments and blast radius
			Arcs through the air and bounces once; direct hits apply Vivisection Marks
			Explodes into homing flesh fragments
			'''
	}

	GazingFleshGrimoire: {
		DisplayName: Gazing Flesh Grimoire
		Tooltip:
			'''
			A forbidden tome sealed in flesh
			Fan-sprays 7 blood bolts in a spread
			Every 4th cast opens a gazing eye that tracks, locks on and bursts into tendrils
			Direct eye hits apply two Vivisection Marks
			'''
	}

	AberrantEyeStaff: {
		DisplayName: Aberrant Eye Staff
		Tooltip:
			'''
			A grotesque staff formed from countless aberrant eyes
			Channeling rouses it: more tendrils, faster and tighter
			Every 6th release conjures a homing aberrant eyeball applying two Vivisection Marks
			Eyeball bursts into a ring of blood projectiles
			'''
	}

	Livinglog: {
		DisplayName: Living Log
		Tooltip: A still-growing fragment of the Dryads' trunk, verdant sap flowing between its rings
	}

