Items: {
	RuyiJinguBang: {
		DisplayName: Ruyi Jingu Bang
		Tooltip:
			'''
			The legendary Ruyi Jingu Bang, anchor of the Eastern Sea
			Four-hit combo ending in a colossal slam; hits build Ruyi Power
			At full power, right-click calls down the Sea-Calming Pillar
			'''
	}

	WoodenStick: {
		DisplayName: Wooden Stick
		Tooltip:
			'''
			A gift from Tang Seng, meant for the destined one
			Two-hit combo; right-click thrusts as the stick extends at will
			'''
	}

	GemStick: {
		DisplayName: Gem Stick
		Tooltip:
			'''
			Anyone struck by it looks a lot more valuable
			Hits scatter prismatic shards; right-click spins a radiant whirl
			'''
	}

	GoldenStick: {
		DisplayName: Golden Stick
		Tooltip:
			'''
			This stick looks a lot more precious now
			Every 4th swing unleashes a triple golden thrust; right-click hurls the stick, which fights and returns
			'''
	}

	IronStick: {
		DisplayName: Iron Stick
		Tooltip:
			'''
			Heavy iron - learn to control its weight
			Three-hit combo ending in a heavy smash; right-click vaults you off the ground
			'''
	}

	RuyiStick: {
		DisplayName: Ruyi Stick
		Tooltip:
			'''
			This stick... reminds you of an old friend
			Every 5th swing grows colossal and swats hostile projectiles
			Hold right-click to charge the Sea-Calming Pillar, release to slam it down
			'''
	}

	TrueRuyiStick: {
		Tooltip:
			'''
			This stick... reeks of monkey
			Double-ended sweeps strike on both sides; its pillar charges faster and splits on impact
