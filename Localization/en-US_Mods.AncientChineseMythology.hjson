	AureateVoidrender: {
		DisplayName: Aureate Voidrender
		Tooltip:
			'''
			A colossal blade that tears through the void itself
			Every swing unleashes a gold-violet void slash wave
			'''
	}

	CelestialHubAnnihilator: {
		DisplayName: Celestial Hub Annihilator
		Tooltip:
			'''
			Channels the power of Tianpivot, fires three-forked annihilation shells
			Each impact detonates a world-ending stellar annihilation
			'''
	}

	CelestialCircletScepter: {
		DisplayName: Celestial Circlet Scepter
		Tooltip:
			'''
			Releases 5 spiraling celestial energy rings
			The rings converge then streak toward the nearest enemy
			'''
	}

	GeoarchonRupturer: {
		DisplayName: Geoarchon Rupturer
		Tooltip:
			'''
			Resonates with earth-force, cracking the abyss asunder
			Summons seven geo-energy pillars at the target location
			'''
	}

	AurelianCataclysmSmasher: {
		DisplayName: Aurelian Cataclysm Smasher
		Tooltip:
			'''
			A catastrophic golden war hammer that shatters all in one blow
			On hit, triggers a ground-rending golden shockwave across the field
			'''
	}

	AzureRuinBlade: {
		DisplayName: Azure Ruin Blade
		Tooltip:
			'''
			Gathering the might of the azure sea, unleash a surging tidal slash
			Releases a crashing blue tidal wave on swing
			'''
	}

	GeocrystalShatterblade: {
		DisplayName: Geocrystal Shatterblade
		Tooltip:
			'''
			Channeling the earth's crystal core, each swing erupts in molten fury
			On hit, triggers a lava crystal burst that shakes the ground
			'''
	}

	QuadraseaCataclysmicEdge: {
		DisplayName: Quadrasea Cataclysmic Edge
		Tooltip:
			'''
			Harnessing the wrath of all four seas, launches three coral wave slashes
			Fires a spread of three coral ocean sword beams on swing
			'''
	}

	VortexPrimordialStain: {
		DisplayName: Vortex Primordial Stain
		Tooltip:
			'''
			Infused with primordial vortex energy, fires three tracking teal-coral orbs
			Orbs coil in serpentine paths before homing in on the nearest enemy
			'''
	}

	LuminanceStellarCannon: {
		DisplayName: Luminance Stellar Cannon
		Tooltip:
			'''
			Condenses starlight into the barrel, firing a piercing white-blue energy bolt
			Triggers a stellar burst explosion on impact
			'''
	}

	LuminousIrisAnnihilator: {
		DisplayName: Luminous Iris Annihilator
		Tooltip:
			'''
			Concentrates brilliant rainbow light, unleashing a devastating golden shell
			Detonates in a cascade of golden radiance on impact
			'''
	}

	TwilightGlazeGreatbow: {
		DisplayName: Twilight Glaze Greatbow
		Tooltip:
			'''
			A twilight greatbow that converts any ammo into coral ocean arrows
			Fires piercing teal-coral arrows that bloom into a sea-light burst on impact
			'''
	}

	StarfireAnnihilator: {
		DisplayName: Starfire Annihilator
		Tooltip:
			'''
			Channels the power of coral starfire, launching a high-speed bolt through multiple foes
			Detonates in a coral-teal star explosion on impact
			'''
	}

	VaultshadeVoidshot: {
		DisplayName: Vaultshade Voidshot
		Tooltip:
			'''
			A brown-tech sniper rifle that fires a growing void bolt as it travels
			On impact, triggers a purple void implosion that draws enemies in
			'''
	}

	ArgentPulseObliterator: {
		DisplayName: Argent Pulse Obliterator
		Tooltip: Rapidly fires silver-blue energy bolts; every 8th shot triggers an overcharged triple burst
	}

	ArcaneRepulsionArray: {
		DisplayName: Arcane Repulsion Array
		Tooltip:
			'''
			Summons a gold-azure dragon-scale drone that patrols and fires piercing lasers at enemies
			The laser penetrates multiple targets
			'''
	}

	AzureTorrentBlades: {
		DisplayName: Azure Torrent Blades
		Tooltip:
			'''
			Summons azure blades that hover in sheaths, then dash out spinning with blue radiance
			Multiple blades can be summoned; they deal contact damage while rapidly rotating
			'''
	}

	DraconicEmber: {
		DisplayName: Draconic Ember
		Tooltip:
			'''
			Summons a lava wyrm that aggressively hunts enemies and periodically launches ember eggs
			Ember eggs explode on contact, scorching all who stand in the way
			'''
	}

	InkscaledFlowFan: {
		DisplayName: Inkscaled Flow Fan
		Tooltip:
			'''
			Summons ink-scaled fish that swim in wave patterns and home in on enemies
			Multiple fish can be summoned to overwhelm foes
			'''
	}

	SolarisEternalVerdict: {
		DisplayName: Solaris Eternal Verdict
		Tooltip:
			'''
			Summons a radiant solar eye that hovers above you and fires sun ray bursts at nearby enemies
			Sun rays penetrate through multiple targets, delivering the Eternal Verdict
			'''
	}

