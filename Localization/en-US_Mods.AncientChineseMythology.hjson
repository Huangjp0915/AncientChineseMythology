	AureateVoidrender: {
		DisplayName: Aureate Voidrender
		Tooltip:
			'''
			A fast golden void blade forged from Vigor's judgment
			Each swing launches three piercing void slash waves for rapid crowd clearing
			Every third swing erupts into five fan waves and tears open a devouring void rift at the cursor
			'''
	}

	CelestialHubAnnihilator: {
		DisplayName: Celestial Hub Annihilator
		Tooltip:
			'''
			Channels the power of Tianpivot, fires three-forked annihilation shells
			Each impact detonates a world-ending stellar annihilation
			'''
	}

	CelestialCircletScepter: {
		DisplayName: Celestial Circlet Scepter
		Tooltip:
			'''
			A mage scepter forged from Vaisravana's celestial circlet authority
			Each cast releases five radiant rings that spiral inward, then dash toward foes
			As each ring expires it crowns the area in a radiant halo, dealing area damage
			'''
	}

	GeoarchonRupturer: {
		DisplayName: Geoarchon Rupturer
		Tooltip:
			'''
			Inscribes a geoarchon rupture sigil at the cursor; after a brief warning, seven earth-energy pillars erupt from the ground
			Pillars fling up geocrystal shards as they shatter; right-click pours mana into a twelve-pillar grand rupture array
			1500 magic damage
			'''
	}

	AurelianCataclysmSmasher: {
		DisplayName: Aurelian Cataclysm Smasher
		Tooltip:
			'''
			Baihu golden cataclysm hammer — 1580 melee damage
			Throws a returning hammer that splits the earth with golden shockwaves on impact; the quakes shred armor
			Catching the hammer slams the ground for a twin-directional quake surge
			'''
	}

	AzureRuinBlade: {
		DisplayName: Azure Ruin Blade
		Tooltip: Held swing releases a tidal lightning wave mid-slash · Chains arcs to nearby foes
	}

	GeocrystalShatterblade: {
		DisplayName: Geocrystal Shatterblade
		Tooltip:
			'''
			Melee swings erupt molten geocrystal bursts on hit; chained hits build crystal resonance for ever-larger bursts
			Max resonance triggers a crystal overload; right-click cleaves a fan of seven molten crystal lances · 1450 melee damage
			'''
	}

	QuadraseaCataclysmicEdge: {
		DisplayName: Quadrasea Cataclysmic Edge
		Tooltip:
			'''
			Harnessing the wrath of all four seas, launches three coral wave slashes
			Fires a spread of three coral ocean sword beams on swing
			'''
	}

	VortexPrimordialStain: {
		DisplayName: Vortex Primordial Stain
		Tooltip: Fires three ink-vortex orbs that serpent-track foes · 365 magic damage
	}

	LuminanceStellarCannon: {
		DisplayName: Luminance Stellar Cannon
		Tooltip:
			'''
			Argus's hundred-eyed stellar cannon
			Gathers violet starlight into a single luminance shell; impact triggers a stellar burst
			The burst ejects four homing starlets that curve back to hunt survivors
			'''
	}

	LuminousIrisAnnihilator: {
		DisplayName: Luminous Iris Annihilator
		Tooltip:
			'''
			Argus iris handgun that converts bullets into luminous golden shells
			Hold to charge an iris ring, then release a golden shell burst on full charge
			A full-charge release summons an All-Seeing Eye that auto-targets foes and fires iris shells
			'''
	}

	TwilightGlazeGreatbow: {
		DisplayName: Twilight Glaze Greatbow
		Tooltip:
			'''
			A twilight greatbow that converts any ammo into coral ocean arrows
			Fires piercing teal-coral arrows that bloom into a sea-light burst on impact
			'''
	}

	StarfireAnnihilator: {
		DisplayName: Starfire Annihilator
		Tooltip:
			'''
			Piercing coral starfire shells bloom into a starfire sea blast after piercing
			Right-click forms a coral supernova that drifts forward, pulling in foes before detonating into a sky of starfire · 1520 ranged damage
			'''
	}

	VaultshadeVoidshot: {
		DisplayName: Vaultshade Voidshot
		Tooltip:
			'''
			Fires a growing void bolt that swells in flight, hitting harder the larger it gets
			Impact triggers a void collapse that pulls nearby enemies inward
			As the collapse unravels it scatters homing fortune coins to plunder the trapped foes
			'''
	}

	ArgentPulseObliterator: {
		DisplayName: Argent Pulse Obliterator
		Tooltip:
			'''
			Baihu argent pulse gun — 1450 ranged damage
			Rapid silver pulse rounds; every eighth shot unleashes a triple pulse burst that blooms into silver shockwaves on impact
			Sustained fire charges the coil; every twenty-fourth shot fires an all-piercing argent pulse railgun round
			'''
	}

	ArcaneRepulsionArray: {
		DisplayName: Arcane Repulsion Array
		Tooltip:
			'''
			Summons a gold-azure dragon-scale drone that patrols and fires piercing lasers at enemies
			The laser penetrates multiple targets
			'''
	}

	AzureTorrentBlades: {
		DisplayName: Azure Torrent Blades
		Tooltip:
			'''
			Rapid alternating dual-blade slashes; sheath torrent blades spiral out
			Right-click deploys an orbiting azure blade swarm
			Hits build tidal stacks; at max charge the next slash unleashes a colossal devouring tidal vortex
			1480 melee damage
			'''
	}

	DraconicEmber: {
		DisplayName: Draconic Ember
		Tooltip: Summons an ember wyrmling · periodically spits lava eggs for AoE burn · 340 summon damage
	}

	InkscaledFlowFan: {
		DisplayName: Inkscaled Flow Fan
		Tooltip: Fans out homing ink-scaled fish; hits apply stacking tidal erosion DoT · 370 magic damage
	}

	SolarisEternalVerdict: {
		DisplayName: Solaris Eternal Verdict
		Tooltip:
			'''
			Summons a hovering solar eye that periodically fires piercing sunbeams
			Sustained targeting charges eclipse power, unleashing a five-beam fan of solar judgment when full · 1600 summon damage
			'''
	}

