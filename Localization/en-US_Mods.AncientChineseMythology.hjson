	YamasDeicide: {
		DisplayName: Yama's Deicide
		Tooltip:
			'''
			The ultimate blade that severs karma and slays gods
			Releases three divine slashes, critical hits trigger Divine Judgment
			Instantly executes non-boss enemies below 15% health
			'''
	}

	DamnedSoulguide: {
		DisplayName: Damned Soulguide
		Tooltip:
			'''
			Guides the souls of those damned to ten thousand calamities
			Fires 5 homing soul arrows with a chance for 3 bonus shots
			Critical hits trigger chained soul explosions
			'''
	}

	SoulEatingCannon: {
		DisplayName: Soul-Eating Cannon
		Tooltip:
			'''
			A heavy nether cannon that devours souls
			Sprays 10-15 soul-eating bullets, causes soul burst on hit
			Absorbs souls to restore life on kill
			'''
	}

	InfinityKarmaBlade: {
		DisplayName: Infinity Karma Blade
		Tooltip:
			'''
			A blade of endless karmic cycles, like the Avici Hell itself
			Throws 3 boomerangs simultaneously with mirror-reflection damage
			Critical hits reflect double damage upon enemies
			'''
	}

	OblivionSoulhook: {
		DisplayName: Oblivion Soulhook
		Tooltip:
			'''
			The Judge's spear of ultimate oblivion and death
			Massive thrust range with heavy life steal on hit
			Killing enemies triggers Oblivion Burst, devastating nearby foes
			'''
	}

	CodexofMyriadDemons: {
		DisplayName: Codex of Myriad Demons
		Tooltip:
			'''
			The ultimate codex recording the karma of ten thousand demons
			Fires 5 homing demon runes per cast
			Critical hits trigger chained lightning across 5 enemies
			'''
	}

	StaveofNetherEclipse: {
		DisplayName: Stave of Nether-Eclipse
		Tooltip:
			'''
			A stave channeling the power of Yellow Spring's oblivion
			Fires 3 eclipse orbs that create binding nether zones on hit
			Enemies in the zone are slowed and scorched by shadow flames
			'''
	}

	SoulShatteringUnderworldBomb: {
		DisplayName: Soul-Shattering Underworld Bomb
		Tooltip:
			'''
			A nether-rock bomb that shatters souls and opens the gates of Yellow Spring
			Splits into 3 cluster bombs after detonation, each with massive blast radius
			No soul can escape the gate once opened
			'''
	}

	CelestialImperatorGreatblade: {
		DisplayName: Celestial Imperator Greatblade
		Tooltip:
			'''
			The blade of myriad calamities forged by the Yin Emperor, severing all cycles of reincarnation
			3-hit combo: first two strikes release 5 Imperator Slashes, third triggers Void Eruption
			Critical hits unleash chained judgment on all enemies within 600 range
			Instantly obliterates non-boss enemies below 25% health
			'''
	}

	PrimordialChaosDeicideBow: {
		DisplayName: Primordial Chaos Deicide Bow
		Tooltip:
			'''
			A deicide bow condensed from primordial chaos energy, requires no mundane arrows
			Fires a Chaos Deicide Arrow that creates a Feather Rain Zone on impact
			Rain zone lasts 3 seconds, showering tracking feather arrows from above
			'''
	}

	HellwyrmAnnihilationCannon: {
		DisplayName: Hellwyrm Annihilation Cannon
		Tooltip:
			'''
			The ultimate cannon sealed with a hell dragon's breath, requires no ammo
			Fires an expanding Dragon Breath Wave that grows larger with distance
			Hit enemies are branded with Annihilation Marks that detonate after 2s for double damage
			'''
	}

	AbyssalFrostJudgmentChakram: {
		DisplayName: Abyssal Frost Judgment Chakram
		Tooltip:
			'''
			The Judgment Wheel of the Nine Hells, condensed from abyssal frost
			Orbits the wielder and auto-targets nearby enemies with dash attacks
			Every 5th hit triggers Absolute Zero Judgment, freezing all enemies in range
			Inflicts Frostburn, Frozen, and Broken Armor on hit
			'''
	}

	VoidDamnationSoulpiercerSpear: {
		DisplayName: Void Damnation Soulpiercer Spear
		Tooltip:
			'''
			The spear of void damnation that pierces through eternal calamity
			Extreme thrust range, leaves a persistent Void Rift along the thrust path
			Ignores enemy defense on hit, heals on every strike
			Killing enemies triggers Void Eruption with massive healing burst
			'''
	}

	NightmareRashomonMyriadCurseTome: {
		DisplayName: Nightmare Rashomon Myriad-Curse Tome
		Tooltip:
			'''
			A forbidden tome recording primordial nightmares and infinite curses
			Summons a Rashomon Gate at cursor position, lasting 4 seconds
			Gate pulls enemies in and continuously damages them
			Spawns 3 Nightmare Tendrils every second to hunt down enemies
			'''
	}

	NetherworldArchonFateScepter: {
		DisplayName: Netherworld Archon Fate Scepter
		Tooltip:
			'''
			The scepter of fate wielded by the Supreme Judge of the Netherworld
			Fires 5 homing Fate Decree Orbs per cast
			Hit enemies are branded with Fate Marks that detonate after 3 seconds
			Detonation damage = accumulated damage x 1.5, with AOE splash
			'''
	}

	ShadowOblivionSingularityBomb: {
		DisplayName: Shadow Oblivion Singularity Bomb
		Tooltip:
			'''
			The ultimate annihilation bomb condensed from void singularity
			Creates a 1-second gravity well that pulls enemies inward on impact
			Followed by a catastrophic implosion covering a massive area
			Killed enemies spawn chain-reaction singularities
			'''
	}

	WoodlandGreatsword: {
		DisplayName: Woodland Greatsword
		Tooltip:
			'''
			A greatsword woven from woodland branches and vines
			Has a chance to inflict Poisoned on hit
			'''
	}

	RootBoomerang: {
		DisplayName: Root Boomerang
		Tooltip:
			'''
			A boomerang crafted from twisted tree roots
			Returns after being thrown, pierces multiple enemies
			'''
	}

	VineHunterBow: {
		DisplayName: Vine Hunter Bow
		Tooltip:
			'''
			A bow woven from living vines
			Arrows have a chance to inflict Poisoned
			'''
	}

	DeadwoodMusket: {
		DisplayName: Deadwood Musket
		Tooltip:
			'''
			A crude musket made from deadwood
			Fires acorn projectiles, consumes no ammo
			'''
	}

	EmeraldTwigStaff: {
		DisplayName: Emerald Twig Staff
		Tooltip:
			'''
			A twig staff inlaid with emeralds
			Releases emerald magic bolts
			'''
	}

	NatureGrimoire: {
		DisplayName: Nature Grimoire
		Tooltip:
			'''
			An ancient grimoire recording nature's power
			Releases three spiraling leaf blades
			Hits have a chance to inflict Poisoned
			'''
	}

	MossBomb: {
		DisplayName: Moss Bomb
		Tooltip:
			'''
			An explosive wrapped in glowing moss
			Explodes on impact, releasing a green mushroom cloud
			Deals area damage and inflicts Poisoned
			'''
	}

	DivineWoodBomb: {
		DisplayName: Divine Wood Bomb
		Tooltip: ""
	}

	DivineWoodGreatblade: {
		DisplayName: Divine Wood Greatblade
		Tooltip: ""
	}

	DivineWoodGyratingLeaf: {
		DisplayName: Divine Wood Gyrating Leaf
		Tooltip:
			'''
			A spinning blade condensed from divine wood leaves
			Thrown toward the cursor, decelerates then returns at high speed
			Return trip deals 1.5x damage, hits release whirlwind leaves
			Every 5 hits triggers Nature's Verdict, releasing a petal barrage
			'''
	}

	DivineWoodLongbow: {
		DisplayName: Divine Wood Longbow
		Tooltip: ""
	}

	DivineWoodMusket: {
		DisplayName: Divine Wood Musket
		Tooltip: ""
	}

	DivineWoodScepter: {
		DisplayName: Divine Wood Scepter
		Tooltip: ""
	}

	DivineWoodTome: {
		DisplayName: Divine Wood Tome
		Tooltip: ""
	}

	ArrogantDivineSylvanGreatblade: {
		DisplayName: Arrogant Divine Sylvan Greatblade
		Tooltip:
			'''
			The ultimate greatblade forged from the essence of the eternal Divine Sylvan
			3-hit combo cycle: Sweep → Upswing → Heavenly Slam
			Sweep releases a piercing vine wave, Upswing fans three rift waves
			Heavenly Slam triggers a massive earthquake, all nature bows before it
			'''
	}

	ArrogantDivineSylvanBomb: {
		DisplayName: Arrogant Divine Sylvan World Seed
		Tooltip:
			'''
			The ultimate explosive seed containing the essence of the World Tree
			Splits mid-flight into five child seeds, each exploding independently
			Each explosion releases swarms of homing vine serpent projectiles
			A myriad of blooms erupt, changing the color of heaven and earth
			'''
	}

	ArrogantDivineSylvanBow: {
		DisplayName: Arrogant Divine Sylvan Bow
		Tooltip:
			'''
			The ultimate longbow bent from the trunk of the World Tree
			Converts arrows into infinitely-piercing vine lances
			Each arrow is accompanied by four DNA-spiral homing leaves
			Every 4th shot fires a World Tree Arrow of devastating power
			'''
	}

	ArrogantDivineSylvanChakram: {
		DisplayName: Arrogant Divine Sylvan Leaf Storm
		Tooltip:
			'''
			The ultimate chakram condensed from ancient divine leaf veins
			Thrown out, then unleashes a rapidly expanding spiral storm at the landing point
			Hold attack to sustain the storm, release to trigger violent implosion
			Implosion releases ten whirlwind leaves + screen shake
			Return trip deals 2x damage, catching triggers another screen shake
			Every 3 hits triggers Myriad Verdict: sixteen petal burst
			Area vine entanglement, all nature stands in judgment
			'''
	}

	ArrogantDivineSylvanMusket: {
		DisplayName: Arrogant Divine Sylvan Musket
		Tooltip:
			'''
			The ultimate rapid-fire weapon driven by World Tree golden thorn mechanisms
			Five-burst golden-emerald thorn needles that chain-bounce on hit
			Every five bursts fires three splitting seed mortars
			Thorns grow into forests, heaven and earth tremble
			'''
	}

	ArrogantDivineSylvanStaff: {
		DisplayName: Arrogant Divine Sylvan Staff
		Tooltip:
			'''
			The ultimate scepter carved from the heart of the ten-thousand-year Divine Sylvan
			Releases a massive vine chain whip to lash enemies
			Chain body sprouts homing tendrils that deal independent damage
			Hits release eight homing leaf bursts
			Endpoint triggers Vine Nova: sixteen-ray ring explosion
			'''
	}

	ArrogantDivineSylvanTome: {
		DisplayName: Arrogant Divine Sylvan Tome
		Tooltip:
			'''
			An ancient supreme treasure recording the spiritual essence of all trees
			Releases 20-28 golden-emerald leaf blades in a fan spread
			Leaves spiral before powerfully homing on enemies
			50% chance on hit to release twin petal sub-projectiles
			Every 3rd use conjures a Leaf Storm Vortex with gravitational pull
			'''
	}

	WoodenLeafPendant: {
		DisplayName: Wooden Leaf Pendant
		Tooltip: Radiates a faint natural aura, granting minor life regeneration
	}

	VineWovenShield: {
		DisplayName: Vine-Woven Shield
		Tooltip:
			'''
			Woven from rough branches and resilient vines
			Increases defense by 1
			Reflects minor thorn damage when hit by contact damage
			'''
	}

	ForestCrystalAmulet: {
		DisplayName: Forest Crystal Amulet
		Tooltip:
			'''
			A rustic amulet infused with forest crystal magic
			Increases maximum mana by 20
			Reduces mana cost by 3%
			'''
	}

	BarkReinforcedGlove: {
		DisplayName: Bark-Reinforced Glove
		Tooltip:
			'''
			A bit rough on the hands, but great for wrist protection
			Increases melee and tool swing speed by 5%
			'''
	}

	WoodlandBarkBoots: {
		DisplayName: Woodland Bark Boots
		Tooltip:
			'''
			Crafted from thick bark and moss, silent on any terrain
			Increases movement speed by 5%
			Reduces fall damage when standing on grass or dirt
			'''
	}

	ProfaneDismemberer: {
		DisplayName: Profane Dismemberer
		Tooltip:
			'''
			A horrific greatsword forged from profane flesh
			Three-hit combo: horizontal slash, upswing, down-chop
			Releases dark blood-flesh waves along swing arc
			Down-chop deals 30% more damage and shakes the ground
			'''
	}

	GluttonousFleshrang: {
		DisplayName: Gluttonous Fleshrang
		Tooltip:
			'''
			A boomerang wrapped in living flesh
			Return hit deals 80% more damage
			Leeches a small amount of life on hit
			Every 4 hits releases homing flesh tendrils
			'''
	}

	TwitchingTendonBow: {
		DisplayName: Twitching Tendon Bow
		Tooltip:
			'''
			An eerie longbow woven from twitching tendons
			Fires penetrating spine bolts with spiral fragments
			Every 3rd shot conjures a homing aberrant eyeball
			Eyeball bursts into homing flesh tendrils on impact
			'''
	}

	VisceraSpitter: {
		DisplayName: Viscera Spitter
		Tooltip:
			'''
			A writhing flesh-barrel gun spitting high-speed blood bullets
			Five-round burst of penetrating blood projectiles
			Every 25th shot conjures a massive viscera glob
			Viscera glob explodes into homing flesh tendrils
			'''
	}

	BurstingTumorBomb: {
		DisplayName: Bursting Tumor Bomb
		Tooltip:
			'''
			A pressurized swollen tumor throwable
			Arcs through the air and bounces once
			Explodes into 8 homing flesh fragments
			Deals massive area blood-blast damage
			'''
	}

	GazingFleshGrimoire: {
		DisplayName: Gazing Flesh Grimoire
		Tooltip:
			'''
			A forbidden tome sealed in flesh
			Fan-sprays 10 blood bolts in a spread
			Every 4th cast releases a homing gazing eyeball
			Eyeball bursts into 8 homing tendrils on impact
			'''
	}

	AberrantEyeStaff: {
		DisplayName: Aberrant Eye Staff
		Tooltip:
			'''
			A grotesque staff formed from countless aberrant eyes
			Continuously releases homing flesh tendrils
			Every 6th release conjures a homing aberrant eyeball
			Eyeball bursts into a ring of blood projectiles
			'''
	}
}

