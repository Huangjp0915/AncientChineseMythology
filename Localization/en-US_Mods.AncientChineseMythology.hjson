	YuChangSword: {
		DisplayName: Yu Chang Sword
		Tooltip:
			'''
			Three inches of cold steel, thin as a cicada's wing
			Drawn without a sound; life and death already decided
			Every fourth thrust pierces bone: bonus damage, a fish-shadow blade, and a slide toward the cursor
			Right click for Heartpiercer Backstab (8s cooldown): blink behind the target for a three-hit flurry
			Executes weakened common enemies; with no target, becomes a phantom lunge
			'''
	}

